{
  "name": "toolstudio",
  "version": "34.0.0",
  "private": true,
  "type": "module",
  "description": "Category-based Calc Studio source and a GitHub Pages build",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "node tests/smoke.mjs",
    "publish:root": "npm run build && node scripts/publish-root.mjs",
    "test:compatibility": "node tests/compatibility.mjs",
    "test:advanced": "node tests/advanced.unit.mjs && node tests/advanced.browser.mjs",
    "test:budgets": "node tests/budgets.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "playwright": "1.58.2",
    "sql.js": "1.15.0",
    "yaml": "2.9.1"
  }
}
